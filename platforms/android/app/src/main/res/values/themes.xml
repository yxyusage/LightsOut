<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      强制 Dark，不用 DayNight。

      这是个真实缺陷：DayNight 跟随系统，用户手机在浅色模式时，
      Material 组件（按钮、开关、输入框）会用浅色默认值，
      而我们所有自定义颜色都是深色系 —— 结果是一个"半深半浅"的界面，
      看起来就像没做过设计。本产品是深夜工具，无论系统设置都必须是深色。
    -->
    <style name="Theme.Xideng" parent="Theme.Material3.Dark.NoActionBar">
        <!-- 主色：琥珀 -->
        <item name="colorPrimary">@color/xideng_primary</item>
        <item name="colorOnPrimary">@color/xideng_on_primary</item>
        <item name="colorPrimaryContainer">@color/xideng_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/xideng_on_primary_container</item>

        <!--
          次要色：TonalButton 吃的就是这两个角色。
          之前没设，所以按钮一直是 Material 默认的淡紫灰。
        -->
        <item name="colorSecondary">@color/xideng_primary</item>
        <item name="colorOnSecondary">@color/xideng_on_primary</item>
        <item name="colorSecondaryContainer">@color/xideng_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/xideng_on_secondary_container</item>

        <!-- 表面与描边 -->
        <item name="android:colorBackground">@color/xideng_surface</item>
        <item name="colorSurface">@color/xideng_surface_alt</item>
        <item name="colorOnSurface">@color/xideng_text_primary</item>
        <item name="colorSurfaceVariant">@color/xideng_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/xideng_on_surface_variant</item>
        <item name="colorOutline">@color/xideng_outline</item>
        <item name="colorError">@color/xideng_danger</item>
        <item name="colorOnError">@color/xideng_on_primary</item>
        <item name="android:statusBarColor">@color/xideng_surface</item>
        <item name="android:navigationBarColor">@color/xideng_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- 黑屏主界面：纯黑、无系统栏，熄灯时不允许任何亮色元素（PRD 2.2.2 / 4.1） -->
    <style name="Theme.Xideng.Blackout" parent="Theme.Xideng">
        <item name="android:windowBackground">@color/xideng_black</item>
        <item name="android:colorBackground">@color/xideng_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 提前预告：全屏半透明，不可关闭（PRD 2.1.2） -->
    <style name="Theme.Xideng.Warning" parent="Theme.Xideng.Blackout">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="Theme.Xideng.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@color/xideng_surface_alt</item>
        <item name="colorSurface">@color/xideng_surface_alt</item>
        <item name="colorOnSurface">@color/xideng_text_primary</item>
    </style>

    <style name="XidengButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="XidengSectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/xideng_text_faint</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="XidengRowTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/xideng_text_primary</item>
    </style>

    <style name="XidengRowSubtitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/xideng_text_faint</item>
        <item name="android:paddingTop">2dp</item>
    </style>
</resources>
