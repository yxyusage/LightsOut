<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xideng_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="熄灯早睡"
            android:textColor="@color/xideng_text_primary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="到点熄灯，把手机交还给睡眠"
            android:textColor="@color/xideng_text_faint"
            android:textSize="13sp" />

        <!--
          状态卡。

          原来这里是一个用纯色平涂当背景的 TextView —— 没有圆角、没有内边距层级，
          视觉上就是"一行字垫了块灰"，与 Web 端的卡片式设计差了整整一个层次。
          改用 bg_card（16dp 圆角）并加大内边距，让它真正成为一张卡片。

          文字本身由 MainActivity 写入：第一行是状态，第二行是剩余时间。
          行距与字号按"状态 + 数字"的层级给，不再是一行等大的字。
        -->
        <TextView
            android:id="@+id/phaseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:fontFamily="sans-serif-light"
            android:lineSpacingExtra="6dp"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:text="——"
            android:textColor="@color/xideng_text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/xideng_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/quotaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/xideng_text_secondary"
            android:textSize="13sp" />

        <TextView
            style="@style/XidengSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="运行所需权限" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="PRD 三、防绕过安全防护体系依赖下列权限。缺任何一项都能继续用，但接管能力会相应减弱。"
            android:textColor="@color/xideng_text_faint"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/permissionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/XidengSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="操作" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/XidengButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="睡眠计划与偏好设置" />

        <Button
            android:id="@+id/btnPreviewWarning"
            style="@style/XidengButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="预览「提前预告」弹窗" />

        <Button
            android:id="@+id/btnDemoBlackout"
            style="@style/XidengButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="演示熄灯界面（15 秒后自动结束）" />

        <Button
            android:id="@+id/btnEmergency"
            style="@style/XidengButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="紧急解除" />

        <TextView
            android:id="@+id/footerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:textColor="@color/xideng_text_faint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
