<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Xideng.Desktop.App"
             RequestedThemeVariant="Dark">
  <!--
    设计令牌集中在这里，三个窗口共享同一份。
    在此之前每个窗口都把颜色内联在自己身上，导致同一款产品在不同窗口里
    出现了十几种灰 —— 这是"看起来不像一个产品"最常见的原因。
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Xideng.Desktop/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- 文本框焦点环：键盘用户必须能看见焦点在哪 -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource XidengPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Application.Styles>
</Application>
