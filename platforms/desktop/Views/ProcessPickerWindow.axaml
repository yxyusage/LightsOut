<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Xideng.Desktop.Views"
        x:Class="Xideng.Desktop.Views.ProcessPickerWindow"
        Title="添加白名单应用"
        Icon="avares://Xideng.Desktop/assets/tray.png"
        Width="560"
        Height="440"
        MinWidth="500"
        MinHeight="380"
        Background="#111111"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="18" ColumnDefinitions="*,Auto">
    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="正在运行的应用" FontSize="15" Foreground="#DDDDDD" Margin="0,0,0,8" />
    <ListBox Grid.Row="1" Grid.RowSpan="2" x:Name="ProcessList" Height="240">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="views:ProcessItem">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Name}" Foreground="#E0E0E0" FontSize="14" />
            <TextBlock Text="{Binding Detail}" Foreground="#8A8A8A" FontSize="11" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="PickerHint" Text="双击列表项直接添加；也可以点击下方按钮浏览 .exe 文件。白名单最多 3 个用户应用。"
               FontSize="12" Foreground="#7A7A7A" TextWrapping="Wrap" Margin="0,10,0,0" />
    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BrowseButton" Content="浏览程序文件…" Padding="16,7" />
      <Button x:Name="AddButton" Content="添加所选" Padding="16,7" />
      <Button x:Name="CancelButton" Content="取消" Padding="16,7" />
    </StackPanel>
  </Grid>
</Window>
