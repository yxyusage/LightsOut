<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Xideng.Desktop.Views"
        x:Class="Xideng.Desktop.Views.SettingsWindow"
        Title="熄灯早睡 · 设置"
        Icon="avares://Xideng.Desktop/assets/tray.png"
        Width="780"
        Height="640"
        MinWidth="720"
        MinHeight="600"
        Background="{StaticResource XidengSurface}"
        WindowStartupLocation="CenterScreen">
  <!--
    外层 Grid 铺满整个窗口，只负责两件事：放背景图、放压暗层。
    内容缩在里层（保留原来的 18px 内边距），这样背景能一直铺到窗口边缘。
  -->
  <Grid>
    <!-- 背景图层：默认深色，用户选了背景图后由 ApplyBackground() 填成 ImageBrush -->
    <Border x:Name="BackgroundLayer" Background="{StaticResource XidengSurface}" />

    <!--
      压暗层（scrim）。
      背景图是照片类内容，亮部（星空、极光的白点）会直接把正文的对比度吃掉 ——
      实测在星空背景下，占位提示文字几乎完全看不见。
      这一层让背景依然看得见，但正文始终保持在可读的对比度上。
      纯深色背景时由代码设为透明，不做任何压暗。
    -->
    <Border x:Name="BackgroundScrim" Background="Transparent" IsHitTestVisible="False" />

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <!-- 标题 -->
    <StackPanel Grid.Row="0" Margin="0,4,0,10">
      <TextBlock Text="熄灯早睡" FontSize="24" Foreground="{StaticResource XidengTextPrimary}" />
      <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource XidengTextSecondary}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 选项卡（外层可滚动：窗口缩小后内容不被截断） -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <TabControl Background="Transparent">
      <TabItem Header="睡眠计划">
        <StackPanel Margin="6,14,6,6" Spacing="12">
          <CheckBox x:Name="PlanEnabledCheck" Content="启用熄灯计划" />
          <Grid ColumnDefinitions="96,168,168" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
            <TextBlock Grid.Row="0" Grid.Column="1" Text="开始（时/分滚轮，可输数字）" Foreground="{StaticResource XidengTextSecondary}" FontSize="12" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="结束（时/分滚轮，可输数字）" Foreground="{StaticResource XidengTextSecondary}" FontSize="12" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="工作日" VerticalAlignment="Top" Margin="0,34,0,0" Foreground="{StaticResource XidengTextBody}" />
            <views:TimeWheel Grid.Row="1" Grid.Column="1" x:Name="WeekdayStartWheel" />
            <views:TimeWheel Grid.Row="1" Grid.Column="2" x:Name="WeekdayEndWheel" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="周末" VerticalAlignment="Top" Margin="0,34,0,0" Foreground="{StaticResource XidengTextBody}" />
            <views:TimeWheel Grid.Row="2" Grid.Column="1" x:Name="WeekendStartWheel" />
            <views:TimeWheel Grid.Row="2" Grid.Column="2" x:Name="WeekendEndWheel" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="熄灯时段必须跨越午夜（如 23:00 → 次日 07:00），时长 30 分钟 – 16 小时。滚动切换、点选列后可直接敲数字（如 2 3 回车到 23，再切到分钟列输 05）。"
                       Foreground="{StaticResource XidengTextFaint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
          </Grid>
          <CheckBox x:Name="SundayAsWeekdayCheck" Content="周日晚按工作日执行（默认开：周一要早起，周日晚上不松懈）" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="提前预告（分钟）" VerticalAlignment="Center" Foreground="{StaticResource XidengTextBody}" />
            <ComboBox x:Name="WarnMinutesCombo" Width="140" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="白名单应用">
        <StackPanel Margin="6,14,6,6" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="共用总时长上限（5-60 分钟）" VerticalAlignment="Center" Foreground="{StaticResource XidengTextBody}" />
            <TextBox x:Name="WhitelistMinutesBox" Width="90" />
          </StackPanel>
          <ListBox x:Name="WhitelistListBox" Height="170" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="AddAppButton" Content="＋ 从运行中的应用选择" Padding="14,5" />
            <Button x:Name="BrowseAppButton" Content="浏览程序文件…" Padding="14,5" />
            <Button x:Name="RemoveAppButton" Content="移除所选" Padding="14,5" />
          </StackPanel>
          <TextBlock Text="无需记进程名：点上方按钮，从正在运行的应用里点选，或直接浏览选择 .exe 文件。白名单最多 3 个用户应用（系统电话 / 短信不受限且不计名额、不占时长）。" FontSize="12" Foreground="{StaticResource XidengTextFaint}" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="紧急解除">
        <StackPanel Margin="6,14,6,6" Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox x:Name="PasswordBox" PasswordChar="*" Watermark="新的紧急解除密码（4-32 位）" Width="250" />
            <Button x:Name="SetPasswordButton" Content="设置密码" Padding="16,6" />
          </StackPanel>
          <TextBlock x:Name="PasswordStatusText" Foreground="{StaticResource XidengTextSecondary}" TextWrapping="Wrap" />
          <TextBlock Text="熄灯界面内连续点击屏幕 5 次可唤起解除入口；每周默认 2 次额度，周一 0 点重置。密码以 SHA-256 摘要仅保存在本机。" FontSize="12" Foreground="{StaticResource XidengTextFaint}" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="外观">
        <StackPanel Margin="6,14,6,6" Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="窗口背景" VerticalAlignment="Center" Foreground="{StaticResource XidengTextBody}" />
            <ComboBox x:Name="AppearanceCombo" Width="240" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="熄灯文字亮度" VerticalAlignment="Center" Foreground="{StaticResource XidengTextBody}" />
            <Slider x:Name="BrightnessSlider" Minimum="0.15" Maximum="1" Width="220" VerticalAlignment="Center" />
            <TextBlock x:Name="BrightnessValueText" Text="0.62" FontSize="12" Foreground="{StaticResource XidengTextSecondary}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="背景均为内置高清夜景图，仅用于窗口观感，不参与熄灯拦截。" FontSize="12" Foreground="{StaticResource XidengTextFaint}" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="高级">
        <StackPanel Margin="6,14,6,6" Spacing="12">
          <CheckBox x:Name="AutoStartCheck" Content="开机自启动" />
          <CheckBox x:Name="ProcessWatchCheck" Content="启用前台进程监听（非白名单应用抢焦点时立即重新接管）" />
          <TextBlock x:Name="PlatformNoteText" FontSize="12" Foreground="{StaticResource XidengTextFaint}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="TestBlackoutButton" Content="测试熄灯窗口（12 秒）" Padding="16,6" />
            <Button x:Name="OpenDataFolderButton" Content="打开数据目录" Padding="16,6" />
            <Button x:Name="ResetButton" Content="恢复默认" Padding="16,6" />
          </StackPanel>
        </StackPanel>
      </TabItem>
      </TabControl>
    </ScrollViewer>

    <!-- 底部：保存 / 状态 -->
    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="SaveButton" Content="保存设置" Padding="22,9" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource XidengSuccess}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock x:Name="ViolationText" Foreground="{StaticResource XidengWarning}" FontSize="12" TextWrapping="Wrap" />
      <TextBlock x:Name="FooterText" FontSize="12" Foreground="{StaticResource XidengTextFaint}" TextWrapping="Wrap" />
    </StackPanel>
    </Grid>
  </Grid>
</Window>
