<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Xideng.Desktop.Views.SettingsWindow"
        Title="熄灯早睡 · 设置"
        Icon="avares://Xideng.Desktop/assets/tray.png"
        Width="780"
        Height="640"
        MinWidth="720"
        MinHeight="600"
        Background="#111111"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <!-- 标题 -->
    <StackPanel Grid.Row="0" Margin="0,4,0,10">
      <TextBlock Text="熄灯早睡" FontSize="22" Foreground="#EAEAEA" />
      <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#8A8A8A" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 选项卡 -->
    <TabControl Grid.Row="1" Background="Transparent">
      <TabItem Header="睡眠计划">
        <StackPanel Margin="6,14,6,6" Spacing="12">
          <CheckBox x:Name="PlanEnabledCheck" Content="启用熄灯计划" />
          <Grid ColumnDefinitions="96,150,150" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="1" Text="开始 HH:MM" Foreground="#9A9A9A" FontSize="12" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="结束 HH:MM" Foreground="#9A9A9A" FontSize="12" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="工作日" VerticalAlignment="Center" Foreground="#CCCCCC" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="WeekdayStartBox" Width="130" HorizontalAlignment="Left" />
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="WeekdayEndBox" Width="130" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="周末" VerticalAlignment="Center" Foreground="#CCCCCC" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="WeekendStartBox" Width="130" HorizontalAlignment="Left" />
            <TextBox Grid.Row="2" Grid.Column="2" x:Name="WeekendEndBox" Width="130" HorizontalAlignment="Left" />
          </Grid>
          <CheckBox x:Name="SundayAsWeekdayCheck" Content="周日晚按工作日执行（默认开：周一要早起，周日晚上不松懈）" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="提前预告（分钟）" VerticalAlignment="Center" Foreground="#CCCCCC" />
            <ComboBox x:Name="WarnMinutesCombo" Width="140" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="白名单应用">
        <StackPanel Margin="6,14,6,6" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="共用总时长上限（5-60 分钟）" VerticalAlignment="Center" Foreground="#CCCCCC" />
            <TextBox x:Name="WhitelistMinutesBox" Width="90" />
          </StackPanel>
          <ListBox x:Name="WhitelistListBox" Height="190" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox x:Name="NewAppNameBox" Watermark="应用名称，如 微信" Width="190" />
            <TextBox x:Name="NewAppProcessBox" Watermark="进程名，如 WeChat" Width="190" />
            <Button x:Name="AddAppButton" Content="添加" Padding="14,5" />
            <Button x:Name="RemoveAppButton" Content="移除所选" Padding="14,5" />
          </StackPanel>
          <TextBlock Text="白名单应用共用总时长；系统电话 / 短信不受限且不占时长。" FontSize="12" Foreground="#7A7A7A" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="紧急解除">
        <StackPanel Margin="6,14,6,6" Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox x:Name="PasswordBox" PasswordChar="*" Watermark="新的紧急解除密码（4-32 位）" Width="250" />
            <Button x:Name="SetPasswordButton" Content="设置密码" Padding="16,6" />
          </StackPanel>
          <TextBlock x:Name="PasswordStatusText" Foreground="#8A8A8A" TextWrapping="Wrap" />
          <TextBlock Text="熄灯界面内连续点击屏幕 5 次可唤起解除入口；每周默认 2 次额度，周一 0 点重置。密码以 SHA-256 摘要仅保存在本机。" FontSize="12" Foreground="#7A7A7A" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="外观">
        <StackPanel Margin="6,14,6,6" Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="窗口背景" VerticalAlignment="Center" Foreground="#CCCCCC" />
            <ComboBox x:Name="AppearanceCombo" Width="240" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="熄灯文字亮度" VerticalAlignment="Center" Foreground="#CCCCCC" />
            <Slider x:Name="BrightnessSlider" Minimum="0.15" Maximum="1" Width="220" VerticalAlignment="Center" />
            <TextBlock x:Name="BrightnessValueText" Text="0.62" FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="背景均为内置高清夜景图，仅用于窗口观感，不参与熄灯拦截。" FontSize="12" Foreground="#7A7A7A" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="高级">
        <StackPanel Margin="6,14,6,6" Spacing="12">
          <CheckBox x:Name="AutoStartCheck" Content="开机自启动" />
          <CheckBox x:Name="ProcessWatchCheck" Content="启用前台进程监听（非白名单应用抢焦点时立即重新接管）" />
          <TextBlock x:Name="PlatformNoteText" FontSize="12" Foreground="#7A7A7A" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="TestBlackoutButton" Content="测试熄灯窗口（12 秒）" Padding="16,6" />
            <Button x:Name="OpenDataFolderButton" Content="打开数据目录" Padding="16,6" />
            <Button x:Name="ResetButton" Content="恢复默认" Padding="16,6" />
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- 底部：保存 / 状态 -->
    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="SaveButton" Content="保存设置" Padding="22,9" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#9AD19A" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock x:Name="ViolationText" Foreground="#C9A27A" FontSize="12" TextWrapping="Wrap" />
      <TextBlock x:Name="FooterText" FontSize="11" Foreground="#666666" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
