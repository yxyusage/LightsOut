<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Xideng.Desktop.Views.SettingsWindow"
        Title="熄灯早睡 · 桌面端设置"
        Width="820"
        Height="880"
        Background="#111111"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer>
    <StackPanel Margin="26" Spacing="16">

      <TextBlock Text="熄灯早睡 · 桌面端" FontSize="26" Foreground="#EAEAEA" />
      <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#8A8A8A" TextWrapping="Wrap" />

      <!-- 睡眠计划 PRD 2.1 -->
      <TextBlock Text="睡眠计划（PRD 2.1）" FontSize="17" Foreground="#DDDDDD" Margin="0,10,0,0" />
      <CheckBox x:Name="PlanEnabledCheck" Content="启用熄灯计划" />
      <Grid ColumnDefinitions="110,190,190" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="1" Text="开始时间 HH:MM" Foreground="#9A9A9A" Margin="0,0,0,6" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="结束时间 HH:MM" Foreground="#9A9A9A" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="工作日" VerticalAlignment="Center" Foreground="#CCCCCC" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="WeekdayStartBox" Width="150" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" Grid.Column="2" x:Name="WeekdayEndBox" Width="150" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="周末" VerticalAlignment="Center" Foreground="#CCCCCC" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="WeekendStartBox" Width="150" HorizontalAlignment="Left" />
        <TextBox Grid.Row="2" Grid.Column="2" x:Name="WeekendEndBox" Width="150" HorizontalAlignment="Left" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="提前预告（分钟）" VerticalAlignment="Center" Foreground="#CCCCCC" />
        <ComboBox x:Name="WarnMinutesCombo" Width="140" />
      </StackPanel>

      <!-- 白名单 PRD 2.2.3 -->
      <TextBlock Text="白名单应用（PRD 2.2.3）" FontSize="17" Foreground="#DDDDDD" Margin="0,10,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="共用总时长上限（5-60 分钟）" VerticalAlignment="Center" Foreground="#CCCCCC" />
        <TextBox x:Name="WhitelistMinutesBox" Width="90" />
      </StackPanel>
      <ListBox x:Name="WhitelistListBox" Height="170" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBox x:Name="NewAppNameBox" Watermark="应用名称，如 微信" Width="200" />
        <TextBox x:Name="NewAppProcessBox" Watermark="进程名，如 WeChat" Width="200" />
        <Button x:Name="AddAppButton" Content="添加" Padding="16,6" />
        <Button x:Name="RemoveAppButton" Content="移除所选" Padding="16,6" />
      </StackPanel>

      <!-- 紧急解除 PRD 2.2.5 -->
      <TextBlock Text="紧急解除密码（PRD 2.2.5）" FontSize="17" Foreground="#DDDDDD" Margin="0,10,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBox x:Name="PasswordBox" PasswordChar="*" Watermark="新的紧急解除密码（4-32 位）" Width="250" />
        <Button x:Name="SetPasswordButton" Content="设置密码" Padding="16,6" />
        <TextBlock x:Name="PasswordStatusText" VerticalAlignment="Center" Foreground="#8A8A8A" />
      </StackPanel>

      <!-- 桌面端能力 PRD 5.2 / 5.3 -->
      <TextBlock Text="桌面端能力（PRD 5.2 / 5.3）" FontSize="17" Foreground="#DDDDDD" Margin="0,10,0,0" />
      <CheckBox x:Name="AutoStartCheck" Content="开机自启动" />
      <CheckBox x:Name="ProcessWatchCheck" Content="启用前台进程监听（非白名单应用抢焦点时立即重新接管）" />
      <TextBlock x:Name="PlatformNoteText" FontSize="12" Foreground="#7A7A7A" TextWrapping="Wrap" />

      <!-- 操作 -->
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,14,0,0">
        <Button x:Name="SaveButton" Content="保存设置" Padding="22,10" />
        <Button x:Name="TestBlackoutButton" Content="测试熄灯窗口（12 秒）" Padding="22,10" />
        <Button x:Name="ResetButton" Content="恢复默认" Padding="22,10" />
        <Button x:Name="OpenDataFolderButton" Content="打开数据目录" Padding="22,10" />
      </StackPanel>

      <TextBlock x:Name="StatusText" Foreground="#9AD19A" TextWrapping="Wrap" />
      <TextBlock x:Name="ViolationText" Foreground="#C9A27A" FontSize="12" TextWrapping="Wrap" />
      <TextBlock x:Name="FooterText" FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,6,0,20" />
    </StackPanel>
  </ScrollViewer>
</Window>
